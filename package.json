{
  "name": "cave-of-absolution",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A complete short text-led adventure: a sixteen-year-old, a hill, and the rite nobody comes back from with anything.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build:only",
    "verify:browser": "node scripts/verify-browser.mjs dist",
    "verify:served": "node scripts/verify-served.mjs dist",
    "verify": "npm run build:only && npm run verify:browser && npm run verify:served"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12 <23"
  }
}
